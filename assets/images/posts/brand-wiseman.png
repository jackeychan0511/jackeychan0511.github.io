<script>
/* 간편견적(quote) 접근 비밀번호 게이트 — 비번은 코드에 평문으로 두지 않고 SHA-256 해시로만 비교 */
(function(){
  var HASH='3aa8d6c09c0adf085477bd2324ccf86d6f9ecca316b18d523dafae285708cc79';
  function sha256(s){
    return crypto.subtle.digest('SHA-256', new TextEncoder().encode(s)).then(function(buf){
      return Array.from(new Uint8Array(buf)).map(function(b){return b.toString(16).padStart(2,'0');}).join('');
    });
  }
  document.addEventListener('click', function(e){
    var a = e.target.closest('.js-quote-gate'); if(!a) return;
    if(sessionStorage.getItem('quote_ok')==='1') return;            // 이번 방문에 이미 통과
    e.preventDefault();
    var pw = prompt('간편견적 이용 비밀번호를 입력하세요\n\n비번문의: 010-2867-7575');
    if(pw===null) return;                                           // 취소
    sha256(pw).then(function(h){
      if(h===HASH){ sessionStorage.setItem('quote_ok','1'); location.href = a.getAttribute('href'); }
      else alert('비밀번호가 올바르지 않습니다.\n\n비번문의: 010-2867-7575');
    }).catch(function(){ alert('확인 중 오류가 발생했어요. 다시 시도해 주세요.'); });
  });
})();
</script>
<!-- ============ TWEAKS ============ -->
<div id="tweaks">
  <h5>Tweaks</h5>
  <div class="group swatchgroup">
    <div class="glabel">Palette</div>
    <div class="swatches" data-key="palette">
      <div class="sw" data-val="ink"    style="background: linear-gradient(to right, #1A1A1A 0 50%, #FAFAF7 50% 100%);"><span class="sw-name">Ink</span></div>
      <div class="sw" data-val="forest" style="background: linear-gradient(to right, #5B8A6E 0 50%, #F3F6EF 50% 100%);"><span class="sw-name">Mint</span></div>
      <div class="sw" data-val="brick"  style="background: linear-gradient(to right, #C96846 0 50%, #F6F1EB 50% 100%);"><span class="sw-name">Coral</span></div>
    </div>
  </div>
  <div class="group">
    <div class="glabel">Hero layout</div>
    <div class="opts" data-key="heroLayout">
      <button class="opt" data-val="editorial">Editorial</button>
      <button class="opt" data-val="poster">Poster</button>
      <button class="opt" data-val="split">Split</button>
    </div>
  </div>
  <div class="group">
    <div class="glabel">Density</div>
    <div class="opts" data-key="density">
      <button class="opt" data-val="airy">Airy</button>
      <button class="opt" data-val="compact">Compact</button>
    </div>
  </div>
</div>

<script>
(function(){
  const state = { ...TWEAK_DEFAULS };

  function apply(){
    const b = document.body;
    b.setAttribute('data-palette', state.palette);
    b.setAttribute('data-hero', state.heroLayout);
    b.setAttribute('data-density', state.density);
    // reflect in UI
    document.querySelectorAll('#tweaks .sw').forEach(el=>{
      el.classList.toggle('active', el.dataset.val === state.palette);
    });
    document.querySelectorAll('#tweaks .opts').forEach(g=>{
      const key = g.dataset.key;
      g.querySelectorAll('.opt').forEach(b=>{
        b.classList.toggle('active', b.dataset.val === state[key]);
      });
    });
  }

  // listen first, then announce
  window.addEventListener('message', (e)=>{
    const d = e.data || {};
    if (d.type === '__activate_edit_mode') document.getElementById('tweaks').classList.add('on');
    if (d.type === '__deactivate_edit_mode') document.getElementById('tweaks').classList.remove('on');
  });
  try { window.parent.postMessage({type: '__edit_mode_available'}, '*'); } catch(e){}

  // tweak interactions
  document.querySelectorAll('#tweaks .sw').forEach(el=>{
    el.addEventListener('click', ()=>{
      state.palette = el.dataset.val;
      apply();
      try { window.parent.postMessage({type:'__edit_mode_set_keys', edits:{palette: state.palette}}, '*'); } catch(e){}
    });
  });
  document.querySelectorAll('#tweaks .opts').forEach(g=>{
    const key = g.dataset.key;
    g.querySelectorAll('.opt').forEach(b=>{
      b.addEventListener('click', ()=>{
        state[key] = b.dataset.val;
        apply();
        try { window.parent.postMessage({type:'__edit_mode_set_keys', edits:{[key]: state[key]}}, '*'); } catch(e){}
      });
    });
  });

  apply();

  const rot = document.getElementById('rotator');
  if (rot) {
    const items = Array.from(rot.children);
    let i = 0;
    setInterval(()=>{
      const cur = items[i];
      i = (i + 1) % items.length;
      const nxt = items[i];
      cur.classList.remove('on'); cur.classList.add('out');
      nxt.classList.remove('out'); nxt.classList.add('on');
      setTimeout(()=>cur.classList.remove('out'), 600);
    }, 2400);
  }

  // --- char reveal for h1 lines ---
  document.querySelectorAll('.hero h1 .reveal-line').forEach((line, li)=>{
    const text = line.dataset.text || line.textContent;
    line.textContent = '';
    const baseDelay = 160 + li * 140; // stagger between lines
    let ci = 0;
    // \uB2E8\uC5B4(\uACF5\uBC31 \uAD6C\uBD84) \uB2E8\uC704\uB85C \uBB36\uC5B4 \uB2E8\uC5B4 \uC911\uAC04 \uC904\uBC14\uAFC8 \uBC29\uC9C0 \u2014 \uB2E8\uC5B4 \uC0AC\uC774\uC5D0\uC11C\uB9CC \uC904\uBC14\uAFC8
    text.split(' ').forEach((word, wi)=>{
      if (wi > 0) { line.appendChild(document.createTextNode(' ')); } // \uC904\uBC14\uAFC8 \uAC00\uB2A5\uD55C \uC2E4\uC81C \uACF5\uBC31
      const w = document.createElement('span');
      w.className = 'word';
      Array.from(word).forEach((ch)=>{
        const s = document.createElement('span');
        s.className = 'char';
        s.textContent = ch;
        s.style.animationDelay = (baseDelay + ci * 28) + 'ms';
        w.appendChild(s); ci++;
      });
      line.appendChild(w);
    });
  });

  // --- hero-visual cross-fade swapper ---
  const hv = document.getElementById('heroVisual');
  if (hv) {
    const layers = hv.querySelectorAll('.hv-layer');
    const tags   = hv.querySelectorAll('.hv-tags .visual-tag');
    const now    = document.getElementById('hvNow');
    const total  = layers.length;
    let idx = 0;
    if (now) {
      const tot = hv.querySelector('.hv-counter');
      if (tot) tot.innerHTML = '<span id="hvNow">01</span> / ' + String(total).padStart(2,'0');
    }
    setInterval(()=>{
      layers[idx].classList.remove('is-on');
      if (tags[idx]) tags[idx].classList.remove('is-on');
      idx = (idx + 1) % total;
      layers[idx].classList.add('is-on');
      if (tags[idx]) tags[idx].classList.add('is-on');
      const n = document.getElementById('hvNow');
      if (n) n.textContent = String(idx + 1).padStart(2,'0');
    }, 5000);
  }
})();
</script>

<!-- 방문 통계 비콘 (자체 접근 통계 — hit.php) -->
<script>
(function(){
  try{
    var d=document, nav=navigator;
    function send(ev){
      try{
        var body='p='+encodeURIComponent(location.pathname)
          +'&r='+encodeURIComponent(d.referrer||'')
          +'&t='+encodeURIComponent((d.title||'').slice(0,120))
          +'&e='+encodeURIComponent(ev||'view')
          +'&sw='+(screen&&screen.width||0);
        if(nav.sendBeacon){ nav.sendBeacon('/hit.php', new Blob([body],{type:'application/x-www-form-urlencoded'})); }
        else{ var x=new XMLHttpRequest(); x.open('POST','/hit.php',true); x.setRequestHeader('Content-Type','application/x-www-form-urlencoded'); x.send(body); }
      }catch(e){}
    }
    send('view');
    d.addEventListener('click',function(e){
      var a=e.target&&e.target.closest?e.target.closest('a'):null; if(!a) return;
      if(a.classList&&a.classList.contains('js-quote-gate')) send('quote_click');
      else if(a.href&&(a.href.indexOf('form.naver.com')>=0||a.href.indexOf('/quote/inquiry')>=0)) send('inquiry_click');
    },true);
  }catch(e){}
})();
</script>

<!-- 콘텐츠 보호(약한 억지용): 우클릭·이미지 드래그·길게눌러 저장 방지. 글자 선택(전화번호 복사 등)은 유지. -->
<style>
  img{-webkit-user-drag:none;-khtml-user-drag:none;-moz-user-drag:none;user-drag:none;-webkit-touch-callout:none}
</style>
<script>
(function(){
  try{
    document.addEventListener('contextmenu',function(e){ e.preventDefault(); }, {capture:true});
    document.addEventListener('dragstart',function(e){
      if(e.target && e.target.tagName==='IMG') e.preventDefault();
    }, {capture:true});
  }catch(e){}
})();
</script>

</body>
</html>
